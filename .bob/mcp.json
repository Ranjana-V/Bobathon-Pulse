      "command": "python3",
      "args": ["/Users/ranjanav/p-ulse/pulse_core/mcp_server.py"],
      "cwd": "/Users/ranjanav/p-ulse",
      "alwaysAllow": [
        "get_logs",
        "get_metrics",
        "get_deployments",
        "get_pods",
        "get_service_dependencies",
        "query_incident_history",
        "write_incident_step",
        "write_incident_rca",
        "run_fix",
        "run_kubectl"
      ]
